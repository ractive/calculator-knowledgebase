#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 James Bergamin
"""Download the source documents listed in sources/manifest.json into raw/.

Python 3.8+, standard library only. Run from anywhere:

    scripts/fetch-sources            # fetch what is missing, verify sha256
    scripts/fetch-sources --dry-run  # show what would happen, no network
    scripts/fetch-sources --check    # HEAD every URL once, download nothing
    scripts/fetch-sources --derive   # also make the derived .txt files

One request at a time, with a pause between requests. Files already in raw/
whose sha256 matches are skipped. 'manual' entries, and derived files that
were not made, are listed at the end with instructions.

Every download and extraction goes to a .part file first and replaces the
file in raw/ only once its SHA-256 matches the manifest; entries marked
hash_stable: false change upstream and are taken as they come, reported as
"unverified". Paths must stay inside raw/, downloads are capped in size, an
https URL may not redirect to http, and the derived commands run without a
shell, limited to the tools listed in DERIVE_TOOLS.
"""

import argparse
import gzip
import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "sources" / "manifest.json"
RAW = ROOT / "raw"
# hpcalc.org refuses generic browser user agents; a Wget-style one works.
USER_AGENT = "Wget/1.21 (calculator-knowledgebase fetch-sources; +https://github.com/ractive/calculator-knowledgebase)"
PAUSE = 1.5  # seconds between requests
TIMEOUT = 120
# Largest download or extracted file without a size in the manifest (the
# largest source is about 130 MB).
MAX_BYTES = 512 << 20
# The only programs a 'derived' entry's command may run, each with the
# options it may take: None for a flag, a set for the values allowed, "path"
# for a file inside raw/. Then how many file arguments (inside raw/) it
# takes, as (least, most).
DERIVE_TOOLS = {
    "textutil": ({"-convert": {"txt"}, "-output": "path"}, (1, 1)),
    "pdftotext": ({"-layout": None, "-nopgbrk": None, "-enc": {"UTF-8", "Latin1", "ASCII7"}}, (2, 2)),
    "cp": ({}, (2, 2)),
}


class Refused(Exception):
    """A manifest entry or a download that is not allowed."""


def inside_raw(rel, what="path"):
    """RAW / rel, refused when rel is absolute or leaves raw/."""
    p = Path(rel)
    if not rel or p.is_absolute() or p.drive or ".." in p.parts:
        raise Refused(f"{what} {rel!r} is not a relative path inside raw/")
    full = (RAW / p).resolve()
    root = RAW.resolve()
    if full == root:
        raise Refused(f"{what} {rel!r} is raw/ itself, not a file in it")
    if root not in full.parents:
        raise Refused(f"{what} {rel!r} resolves outside raw/")
    return RAW / p


def unverified(entry):
    return not entry.get("hash_stable", True)


def size_cap(entry):
    """Most bytes `entry`'s file may have: its manifest size when its hash is
    stable (more cannot match), else MAX_BYTES."""
    if entry is not None and entry.get("size") and not unverified(entry):
        return min(int(entry["size"]), MAX_BYTES)
    return MAX_BYTES


def copy_capped(src, out, cap, what):
    total = 0
    for chunk in iter(lambda: src.read(1 << 20), b""):
        total += len(chunk)
        if total > cap:
            raise Refused(f"{what} is larger than {cap} bytes")
        out.write(chunk)
    return total


def verified_replace(entry, tmp, dest, problems):
    """Move tmp over dest when its SHA-256 matches entry (or the entry is
    unverified); otherwise delete tmp and record the mismatch. Returns
    whether dest was replaced."""
    # A missing hash is a mismatch: only an unverified entry is kept then.
    if check_hash(entry, tmp, problems, entry["path"]):
        tmp.replace(dest)
        return True
    if unverified(entry):
        tmp.replace(dest)
        return True
    tmp.unlink(missing_ok=True)
    return False


class NoDowngrade(urllib.request.HTTPRedirectHandler):
    """Follow redirects, but never from https to http."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if req.full_url.lower().startswith("https:") and newurl.lower().startswith("http:"):
            raise Refused(f"{req.full_url} redirects to plain http ({newurl}); refused")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


OPENER = urllib.request.build_opener(NoDowngrade)


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


class Fetcher:
    def __init__(self):
        self.last = 0.0

    def _wait(self):
        delay = self.last + PAUSE - time.monotonic()
        if delay > 0:
            time.sleep(delay)
        self.last = time.monotonic()

    def download(self, url, tmp, cap=MAX_BYTES):
        """Download url into tmp (at most cap bytes, decompressed); tmp is
        deleted when anything fails."""
        self._wait()
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        tmp.parent.mkdir(parents=True, exist_ok=True)
        try:
            with OPENER.open(req, timeout=TIMEOUT) as resp, open(tmp, "wb") as out:
                body = resp
                # Wayback raw (id_) fetches may arrive gzip-encoded
                if resp.headers.get("Content-Encoding", "").lower() == "gzip":
                    body = gzip.GzipFile(fileobj=resp)
                copy_capped(body, out, cap, url)
        except BaseException:
            tmp.unlink(missing_ok=True)
            raise

    def head(self, url):
        self._wait()
        req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": USER_AGENT})
        try:
            with OPENER.open(req, timeout=60) as resp:
                return resp.status, resp.headers.get("Content-Length")
        except Refused as e:
            return None, str(e)
        except urllib.error.HTTPError as e:
            if e.code in (403, 405, 501):
                # some servers refuse HEAD; ask for the first byte instead
                req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Range": "bytes=0-0"})
                self._wait()
                try:
                    with OPENER.open(req, timeout=60) as resp:
                        return resp.status, resp.headers.get("Content-Range")
                except urllib.error.HTTPError as e2:
                    return e2.code, None
            return e.code, None


def check_hash(entry, path, problems, name=None):
    got = sha256_of(path)
    if isinstance(entry.get("sha256"), str) and got == entry["sha256"]:
        return True
    if entry["method"] == "derived":
        kind = "differs from the library's conversion (tool version; expected)"
    elif unverified(entry):
        kind = "unverified: changed upstream (expected for this entry)"
    else:
        kind = "SHA-256 MISMATCH (not kept)"
    problems.append(f"{name or entry['path']}: {kind}: got {got}")
    return False


def present(entry):
    p = RAW / entry["path"]
    return p.is_file() and isinstance(entry.get("sha256"), str) and sha256_of(p) == entry["sha256"]


def part_of(dest):
    return dest.with_name(dest.name + ".part")


def derive_argv(entry):
    """The derived entry's command as an argv list: an allowed tool with
    only its allowed options (DERIVE_TOOLS), every path inside raw/."""
    command = entry["command"]
    argv = shlex.split(command)
    if not argv or argv[0] not in DERIVE_TOOLS:
        raise Refused(f"command {command!r}: only {', '.join(sorted(DERIVE_TOOLS))} may run")
    options, (least, most) = DERIVE_TOOLS[argv[0]]

    def value_ok(flag, value):
        kind = options[flag]
        if kind == "path":
            inside_raw(value, f"{flag} value")
        elif value not in kind:
            raise Refused(f"command {command!r}: {flag} {value!r} is not allowed")

    files = []
    rest = iter(argv[1:])
    for arg in rest:
        # No shell runs it; a shell's syntax in it is a mistake or worse.
        if any(c in arg for c in ";&|<>$`*?\n"):
            raise Refused(f"command {command!r}: {arg!r} looks like shell syntax")
        if not arg.startswith("-"):
            inside_raw(arg, "command argument")
            files.append(arg)
            continue
        flag, eq, value = arg.partition("=")
        if flag not in options:
            raise Refused(f"command {command!r}: option {arg!r} is not allowed for {argv[0]}")
        if options[flag] is None:
            if eq:
                raise Refused(f"command {command!r}: {flag} takes no value")
            continue
        if not eq:
            value = next(rest, None)
            if value is None:
                raise Refused(f"command {command!r}: {flag} needs a value")
        value_ok(flag, value)
    if not least <= len(files) <= most:
        raise Refused(f"command {command!r}: {argv[0]} takes {least}-{most} file arguments, not {len(files)}")
    return argv


def tag(entry):
    return " (unverified)" if unverified(entry) else ""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="print the plan, touch nothing")
    ap.add_argument("--check", action="store_true", help="HEAD each URL once and report dead ones")
    ap.add_argument("--derive", action="store_true", help="run the commands of 'derived' entries")
    ap.add_argument("--only", metavar="PREFIX", help="limit to paths starting with PREFIX")
    args = ap.parse_args()

    entries = json.loads(MANIFEST.read_text(encoding="utf-8"))["entries"]
    refused = []
    for e in entries:
        try:
            for key in ("path", "zip", "derived_from"):
                if key in e:
                    inside_raw(e[key], key)
            if e.get("command"):
                derive_argv(e)
            if not isinstance(e.get("sha256"), str) and not unverified(e):
                raise Refused("no sha256 (and not hash_stable: false)")
        except Refused as err:
            refused.append(f"{e.get('path')!r}: REFUSED: {err}")
    if refused:
        print("The manifest has entries that are not allowed:", file=sys.stderr)
        for r in refused:
            print(f"- {r}", file=sys.stderr)
        return 1
    if args.only:
        entries = [e for e in entries if e["path"].startswith(args.only)]
    by_path = {e["path"]: e for e in entries}
    fetcher = Fetcher()

    if args.check:
        urls = []
        for e in entries:
            for key in ("url", "zip_url"):
                if e.get(key) and e[key] not in urls:
                    urls.append(e[key])
        dead = []
        for u in urls:
            status, info = fetcher.head(u)
            ok = status is not None and 200 <= status < 400
            print(f"{'ok  ' if ok else 'DEAD'} {status} {u}" + (f" ({info})" if info else ""))
            if not ok:
                dead.append(u)
        print(f"\n{len(urls)} URLs, {len(dead)} not reachable")
        return 1 if dead else 0

    problems, manual, derived_todo = [], [], []
    done = skipped = 0
    remote_zips = {}  # zip_url -> local temp file

    def ensure_zip(entry):
        if "zip" in entry:
            zpath = RAW / entry["zip"]
            if not zpath.is_file():
                zentry = by_path.get(entry["zip"])
                if zentry is None or zentry["method"] != "fetch":
                    raise RuntimeError(f"zip {entry['zip']} not available")
                print(f"fetch   {zentry['path']}{tag(zentry)}")
                tmp = part_of(zpath)
                fetcher.download(zentry["url"], tmp, size_cap(zentry))
                if not verified_replace(zentry, tmp, zpath, problems):
                    raise RuntimeError(f"zip {entry['zip']} did not match its SHA-256")
            return zpath
        url = entry["zip_url"]
        if url not in remote_zips:
            fd, name = tempfile.mkstemp(suffix=".zip")
            os.close(fd)
            print(f"fetch   {url} (temporary)")
            try:
                fetcher.download(url, Path(name))
            except BaseException:
                Path(name).unlink(missing_ok=True)
                raise
            remote_zips[url] = Path(name)
        return remote_zips[url]

    try:
        for e in entries:
            dest = RAW / e["path"]
            method = e["method"]
            if method == "manual":
                if not present(e):
                    manual.append(e)
                continue
            if method == "derived":
                if present(e):
                    skipped += 1
                elif args.derive and e.get("command") and not args.dry_run:
                    derived_todo.append(e)
                else:
                    manual.append(e)
                continue
            if present(e):
                skipped += 1
                continue
            if args.dry_run:
                src = e.get("url") or (f"{e.get('zip') or e.get('zip_url')} :: {e['member']}")
                print(f"would {method:10} {e['path']}{tag(e)}  <-  {src}")
                continue
            tmp = part_of(dest)
            try:
                if method == "fetch":
                    print(f"fetch   {e['path']}{tag(e)}")
                    fetcher.download(e["url"], tmp, size_cap(e))
                elif method == "zip-member":
                    zpath = ensure_zip(e)
                    print(f"extract {e['path']}{tag(e)}")
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    cap = size_cap(e)
                    with zipfile.ZipFile(zpath) as zf:
                        if zf.getinfo(e["member"]).file_size > cap:
                            raise Refused(f"member {e['member']} is larger than {cap} bytes")
                        with zf.open(e["member"]) as src, open(tmp, "wb") as out:
                            copy_capped(src, out, cap, e["member"])
                else:
                    problems.append(f"{e['path']}: unknown method {method}")
                    continue
                if verified_replace(e, tmp, dest, problems):
                    done += 1
            except (urllib.error.URLError, OSError, KeyError, RuntimeError, zipfile.BadZipFile, Refused) as err:
                problems.append(f"{e['path']}: FAILED: {err}")
            finally:
                tmp.unlink(missing_ok=True)
    finally:
        for p in remote_zips.values():
            p.unlink(missing_ok=True)

    for e in derived_todo:
        src = RAW / e["derived_from"]
        if not src.is_file():
            manual.append(e)
            continue
        argv = derive_argv(e)
        if shutil.which(argv[0]) is None:
            manual.append(e)
            continue
        print(f"derive  {e['path']}")
        try:
            subprocess.run(argv, cwd=RAW, check=True)
        except (OSError, subprocess.CalledProcessError) as err:
            problems.append(f"{e['path']}: FAILED: {err}")
            continue
        if (RAW / e["path"]).is_file():
            check_hash(e, RAW / e["path"], problems)
            done += 1

    print(f"\n{done} fetched or made, {skipped} already present")
    loose = [e for e in entries if unverified(e) and e["method"] != "manual"]
    if loose:
        print(f"\nUnverified ({len(loose)}, hash_stable: false; taken as they come):")
        for e in loose:
            print(f"- {e['path']}")
    if manual:
        print(f"\nNot fetched automatically ({len(manual)}):")
        for e in manual:
            if e["method"] == "manual":
                print(f"- {e['path']}\n    {e['instructions']}")
            else:
                how = e.get("command") or e.get("how")
                print(f"- {e['path']} (derived from {e['derived_from']})\n    {how}"
                      + ("" if not e.get("command") else "  [run with --derive]"))
    if problems:
        print(f"\nProblems ({len(problems)}):")
        for p in problems:
            print(f"- {p}")
    hard = [p for p in problems if "MISMATCH" in p or "FAILED" in p]
    return 1 if hard else 0


if __name__ == "__main__":
    sys.exit(main())
